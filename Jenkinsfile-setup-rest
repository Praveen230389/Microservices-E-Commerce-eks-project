pipeline {
    agent any

    stages {
        stage('Checkout from Git') {
            steps {
                echo 'Checking out Git repository...'
            }
        }

        stage ('Create Namespace for ArgoCD') {
            steps {
                sh 'kubectl create namespace argocd'
            }
        }

        stage ('Install ArgoCD in the Created Namespace') {
            steps {
                sh 'kubectl apply -n argocd \
                      -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml'
            }
        }

        stage ('verify EKS repositories') {
            steps {
                sh 'aws ecr describe-repositories --region us-east-1'
            }
        }

        stage ('Ensure all pods are in Running state.') {
            steps {
                sh 'kubectl get pods -n argocd'
            }
        }

        stage ('Validate the Cluster') {
            steps {
                sh 'kubectl get nodes'
            }
        }

        stage ('List All ArgoCD Resources') {
            steps {
                sh 'kubectl get all -n argocd'
            }
        }

        stage ('Create Namespace in EKS') {
            steps {
                sh '''
                   kubectl create namespace dev
                   kubectl get namespaces
                   '''
            }
        }

        stage ('Create a Namespace for Monitoring') {
            steps {
                sh 'kubectl create namespace monitoring'
            }
        }

        stage ('Add Prometheus & Grafana Helm Chart Repo') {
            steps {
                sh '''
                   helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
                   helm repo update
                   '''
            }
        }

        stage ('Install the Kube Prometheus Stack') {
            steps {
                sh 'helm install kube-prom-stack prometheus-community/kube-prometheus-stack \
                      --namespace monitoring'
            }
        }

        stage ('Check That Everything Is Running') {
            steps {
                sh 'kubectl get pods -n monitoring'
            }
        }

        stage ('All External Outputs') {
            steps {
                sh '''
                   kubectl get svc argocd-server -n argocd

                   sleep 300

                   kubectl get secret argocd-initial-admin-secret -n argocd \
                     -o jsonpath="{.data.password}" | base64 -d && echo

                   sleep 300

                   kubectl get svc kube-prom-stack-grafana -n monitoring

                   sleep 300

                   kubectl get secret kube-prom-stack-grafana -n monitoring -o jsonpath="{.data.admin-password}" | base64 -d && echo
                   '''
            }
        }
    }
}
